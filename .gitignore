# DubTool .gitignore (AGENT_UPDATE_6.md section 8.1)
# Media, models, environments and build output are never pushed.

# Environment / secrets (keep .env.example)
.env*
!.env.example

# Virtual environments and the build environment
.venv/
venv/
.venv-build/
.venv-build-tmpdist/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/

# AGU8 task 9: generated evaluation files (never in Git)
eval/

# Build output
build/
dist/

# Tooling / vendored binaries / model caches
vendor/
models/

# Jobs (contain user media and transcripts) and samples
jobs/
sample/

# Assistant review packages and generated screenshots
review/
excerpts/
screenshots/
shots*/
check/
old_before_*/

# Logs and reports
*.log
cleanup.log

# Signed material
*.pfx
*.p12
*.pem
*.key
*.cer

# Media files
*.mp4
*.mov
*.mkv
*.webm
*.avi
*.m4v
*.wav
*.mp3
*.m4a

# Archives
*.zip

# User-media transcripts outside the test fixtures
transcript*.json
translated*.json
!tests/fixtures/transcript*.json
!tests/fixtures/translated*.json

# Editor settings
.vscode/
build_log.txt
build_layout_smoke.log

# AGU10 task 6.1: generated tooling output and heavy assets — keep every
# entry above. tests/fixtures is still allowed for the small fixture .bin.
.freebuff/
inventory/
hf-cache/
tmp/
build_log*
exe_build*
cleanup_dryrun.txt
*.onnx
*.bin
!tests/fixtures/*.onnx
!tests/fixtures/*.bin

# Untracked local workspace rules and post-commit generated evidence files
AGENTS.md
DOD_REPORT.md
RELEASE_EVIDENCE.txt
REPORT_UPDATE_15.md
REVIEW_NOTES.md
docs/images/INDEX.txt

